{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/trip/:token",
      "destination": "/trip"
    },
    {
      "source": "/report/:token",
      "destination": "/report"
    },
    {
      "source": "/upgrade/:token",
      "destination": "/upgrade"
    }
  ],
  "functions": {
    "api/trip.js": {
      "maxDuration": 90
    },
    "api/admin.js": {
      "maxDuration": 90
    },
    "api/hostaway.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(trip|admin|report|upgrade)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "17 15 * * *"
    }
  ]
}