{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/trip/:token", "destination": "/trip" }
  ],
  "functions": {
    "api/trip.js": { "maxDuration": 90 },
    "api/admin.js": { "maxDuration": 90 },
    "api/hostaway.js": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/(trip|admin)(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }
  ]
}
